import numpy as np

# 1. Create a one-dimensional array from 1 to 10
arr = np.arange(1, 11)

print("Original Array:")
print(arr)

# 2. Perform slicing operations
print("\nSlicing Operations:")
print("First five elements:", arr[:5])
print("Elements from index 3 to 7:", arr[3:8])
print("Last three elements:", arr[-3:])
print("Every second element:", arr[::2])

# 3. Compute statistical measures
print("\nStatistical Measures:")
print("Sum:", np.sum(arr))
print("Mean:", np.mean(arr))
print("Maximum:", np.max(arr))
print("Minimum:", np.min(arr))

# 4. Apply broadcasting to modify array elements
print("\nBroadcasting Operations:")
print("Add 5 to every element:", arr + 5)
print("Multiply every element by 2:", arr * 2)
print("Subtract 1 from every element:", arr - 1)

# Modify the original array using broadcasting
arr += 5

print("\nModified Original Array:")
print(arr)
